<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de lista -->
    <record id="view_curso_odoo_list" model="ir.ui.view">
        <field name="name">curso.odoo.list</field>
        <field name="model">curso.odoo</field>
        <field name="arch" type="xml">
           <list string="Cursos">
    <field name="name"/>
    <field name="edad"/>
    <field name="precio"/>
    <field name="fecha_inicio"/>
    <field name="activo"/>
    <field name="profesor_id"/>
</list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_curso_odoo_form" model="ir.ui.view">
        <field name="name">curso.odoo.form</field>
        <field name="model">curso.odoo</field>
        <field name="arch" type="xml">
            <form string="Curso">
                <sheet>

                    <group>
    <field name="name"/>
    <field name="activo"/>
    <field name="edad"/>
    <field name="precio"/>
    <field name="fecha_inicio"/>
    <field name="profesor_id"/>
</group>

<group>
    <field name="descripcion"/>
</group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_curso_odoo" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">curso.odoo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú principal -->
    <menuitem
        id="menu_curso_odoo_root"
        name="Curso Odoo"
        sequence="10"/>

    <!-- Submenú -->
    <menuitem
        id="menu_curso_odoo"
        name="Cursos"
        parent="menu_curso_odoo_root"
        action="action_curso_odoo"
        sequence="10"/>

</odoo>